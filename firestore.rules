rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owns(uid);
      // Account creation and security-owned fields are server-authoritative.
      allow create: if false;
      allow delete: if false;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'walletAddress', 'maxRiskPercent', 'maxTradeSize',
          'tradingPreferences', 'apiKeyMetadata', 'securitySettings', 'updatedAt'
        ])
        && request.resource.data.status == resource.data.status
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.monthlyUsage == resource.data.monthlyUsage
        && request.resource.data.subscription == resource.data.subscription
        && request.resource.data.api == resource.data.api
        && request.resource.data.trialStartedAt == resource.data.trialStartedAt
        && request.resource.data.trialEndsAt == resource.data.trialEndsAt
        && request.resource.data.subscriptionEndsAt == resource.data.subscriptionEndsAt
        && request.resource.data.securitySettings.deviceBindingId == resource.data.securitySettings.deviceBindingId;

      match /transactions/{transactionId} {
        allow read, create, update, delete: if owns(uid);
      }
      match /trades/{tradeId} {
        allow read, create, update, delete: if owns(uid);
      }
      match /paymentVerifications/{verificationId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.transactionHash is string
          && request.resource.data.transactionHash.size() >= 8
          && request.resource.data.transactionHash.size() <= 200
          && request.resource.data.asset is string
          && request.resource.data.network is string
          && request.resource.data.amount is number;
        allow update, delete: if false;
      }
    }

    match /deviceBindings/{deviceBindingId} {
      allow read, write: if false;
    }
  }
}
