rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string;

      allow read: if owns(uid);

      allow update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.monthlyUsage == resource.data.monthlyUsage
        && request.resource.data.subscription == resource.data.subscription
        && request.resource.data.api == resource.data.api
        && request.resource.data.trialStartedAt == resource.data.trialStartedAt
        && request.resource.data.trialEndsAt == resource.data.trialEndsAt
        && request.resource.data.subscriptionEndsAt == resource.data.subscriptionEndsAt
        && request.resource.data.latestPaymentVerification == resource.data.latestPaymentVerification
        && (
          !('securitySettings' in resource.data)
          || !('deviceBindingId' in resource.data.securitySettings)
          || request.resource.data.securitySettings.deviceBindingId == resource.data.securitySettings.deviceBindingId
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'emailVerified', 'username', 'displayName', 'photoURL', 'authProvider', 'authProviders',
          'walletAddress', 'maxRiskPercent', 'maxTradeSize', 'tradingPreferences', 'apiKeyMetadata',
          'securitySettings', 'deviceBindingId', 'lastSeenAt', 'lastSeenIp', 'createdAt', 'updatedAt',
          'premiumUntil'
        ]);

      allow delete: if false;

      match /transactions/{transactionId} {
        allow read, create, update, delete: if owns(uid);
      }
      match /trades/{tradeId} {
        allow read, create, update, delete: if owns(uid);
      }
      match /paymentVerifications/{verificationId} {
        allow read: if owns(uid);
        allow create, update, delete: if false;
      }
    }

    match /deviceBindings/{deviceBindingId} {
      allow read, write: if false;
    }
  }
}
