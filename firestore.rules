rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if false;
      allow delete: if false;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'walletAddress', 'maxRiskPercent', 'maxTradeSize', 'tradingPreferences', 'apiKeyMetadata', 'securitySettings', 'updatedAt'
        ]);

      match /transactions/{transactionId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid);
        allow delete: if owns(uid);
      }

      match /trades/{tradeId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid);
        allow delete: if owns(uid);
      }
    }
  }
}
