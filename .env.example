# Firebase Web App configuration
# Copy to .env.local and fill from Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side only. Never expose this as VITE_* or NEXT_PUBLIC_*.
ZEROX_API_KEY=

FIREBASE_SERVICE_ACCOUNT_JSON=
AFFILIATE_COMMISSION_BPS=1000
AFFILIATE_TREASURY_PRIVATE_KEY=
AFFILIATE_TREASURY_ADDRESS=
BSC_RPC_URL=https://bsc-dataseed.binance.org
CRON_SECRET=

# OANDA broker market data (server-side only; never use VITE_ prefix)
# Demo: https://api-fxpractice.oanda.com
# Live: https://api-fxtrade.oanda.com
OANDA_API_URL=
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
