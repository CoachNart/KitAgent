# WalletConnect / Reown Cloud project ID
VITE_WALLETCONNECT_PROJECT_ID=

# Public UI fee display
VITE_KITAGENT_FEE_BPS=25

# LI.FI monetization
KITAGENT_LIFI_INTEGRATOR=kitagent
KITAGENT_LIFI_FEE=0.0025

# Firebase Web SDK — safe to expose through Vite to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin — SERVER ONLY. Put the complete service-account JSON in Vercel.
# Never prefix this with VITE_ and never commit the JSON to GitHub.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe — SERVER ONLY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=https://kitagent.xyz
