# WalletConnect / Reown Cloud project ID
# Create one at https://dashboard.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# Public UI fee display (25 bps = 0.25%)
VITE_KITAGENT_FEE_BPS=25

# LI.FI monetization. Configure the same integrator in LI.FI Portal and assign its fee wallet.
KITAGENT_LIFI_INTEGRATOR=kitagent
KITAGENT_LIFI_FEE=0.0025

# Stripe recurring billing for Pro / Developer / Startup.
# Keep these server-side in Vercel Environment Variables; never prefix with VITE_.
STRIPE_SECRET_KEY=
KITAGENT_PRO_PRICE_ID=
KITAGENT_DEVELOPER_PRICE_ID=
KITAGENT_STARTUP_PRICE_ID=
KITAGENT_APP_URL=
